{
    "name": "sbom-vuln-analysis-tarea-3",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },

    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
                "python.formatting.provider": "black",
                "editor.formatOnSave": true,
                "notebook.formatOnSave.enabled": true,
                "jupyter.notebook.defaultKernel": "sbom-vuln-analysis"
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.black-formatter",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "postCreateCommand": "uv sync && grype db update && uv run scripts/add_submodules.py",
    "remoteUser": "vscode",
    "runArgs": ["--name", "sbom-vuln-analysis-tarea-3"],
    "mounts": [
        "source=${localWorkspaceFolder}/data,target=${containerWorkspaceFolder}/data,type=bind,consistency=cached"
    ]
}
